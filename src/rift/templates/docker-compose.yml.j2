services:
  {{ package_name }}_api:
    container_name: {{ package_name }}-api-service
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "9000:8000"
    volumes:
      - ./:/code
    env_file:
      - path: .env.example
      - path: .env
        required: false
{% if include_mongodb %}    environment:
      MONGO_URI: mongodb://mongo:27017
    depends_on:
      - mongo

  mongo:
    image: mongo:7
    container_name: {{ package_name }}-mongo
    restart: unless-stopped
    ports:
      - "${MONGO_PORT:-27017}:27017"
    volumes:
      - mongo_data:/data/db

volumes:
  mongo_data:
{% endif %}
