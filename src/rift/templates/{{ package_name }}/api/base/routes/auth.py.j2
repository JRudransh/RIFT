from fastapi import APIRouter, HTTPException, Request
from fastapi.responses import JSONResponse

from {{ package_name }}.api.base.models.generic_model import Success
from {{ package_name }}.api.base.models.user_model import LoginIn, TokenOut, UserCreate
from {{ package_name }}.api.base.operations.user_ops import UserOps
from {{ package_name }}.api.config import Config
from {{ package_name }}.api.security import Jwt, verify_password

router = APIRouter(prefix="/auth", tags=["Auth"])


@router.post("/login", response_model=TokenOut)
async def login(payload: LoginIn):
    user = await UserOps(user_id=None, org_id=payload.org_id).get_user_by_email(payload.email)
    if not user or not verify_password(payload.password, user.get("password_hash", "")):
        raise HTTPException(status_code=401, detail="Invalid credentials")
    token = Jwt.create_access_token(str(user["_id"]), payload.org_id, bool(user.get("is_admin", False)))
    response = JSONResponse({"access_token": token, "token_type": "bearer"})
    response.set_cookie(
        Config.AUTH_COOKIE_NAME,
        token,
        httponly=Config.COOKIE_HTTPONLY,
        secure=Config.COOKIE_SECURE,
        samesite=Config.COOKIE_SAMESITE,
        domain=Config.COOKIE_DOMAIN,
        max_age=Config.JWT_EXPIRATION,
    )
    return response


@router.post("/register", response_model=Success)
async def register(request: Request, payload: UserCreate):
    if not getattr(request.state, "is_authenticated", False):
        raise HTTPException(status_code=401, detail="You are not authenticated")
    user_id = await UserOps(user_id=request.state.user_id, org_id=request.state.org_id).create_user(payload)
    return Success(message=f"User created with id: {user_id}")


@router.post("/logout", response_model=Success)
async def logout():
    response = JSONResponse(Success(message="Logged out").model_dump())
    response.delete_cookie(Config.AUTH_COOKIE_NAME)
    return response
