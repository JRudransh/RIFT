[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ project_name }} API generated by RIFT."
requires-python = ">=3.12"
dependencies = [
    "fastapi[standard]>=0.115.0",
    "uvicorn[standard]>=0.30.0",
    "pymongo>=4.11.0",
    "pydantic>=2.8.0",
    "email-validator>=2.2.0",
    "python-decouple>=3.8",
    "loguru>=0.7.2",
    "pwdlib>=0.2.1",
    "PyJWT>=2.9.0",
    "python-multipart>=0.0.9",
]

[tool.uv]
package = false
